# ===== Database (MySQL-compatible) =====
# Lokal (Laragon/XAMPP/Docker):
DATABASE_URL="mysql://root:@127.0.0.1:3306/arsindo"
# Production TiDB Cloud Serverless (wajib SSL), contoh:
# DATABASE_URL="mysql://USER.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/arsindo?sslaccept=strict"

# ===== Auth.js =====
# Generate: npx auth secret   atau   openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# URL website (production: https://arsindoniaga.co.id)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Folder induk di Cloudinary
CLOUDINARY_ROOT_FOLDER="arsindo"

# ===== Seeder: akun admin awal =====
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL="admin@arsindoniaga.co.id"
SEED_ADMIN_PASSWORD="GantiPassword#2026"

# Salt untuk hash IP (rate limit & log pesan)
IP_HASH_SALT="ganti-dengan-string-acak"
